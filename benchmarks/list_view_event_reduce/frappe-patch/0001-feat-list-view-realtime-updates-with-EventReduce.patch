new file mode 100644
index 0000000..9004b03
--- /dev/null
+++ b/frappe/public/js/frappe/list/list_result_window.js
@@ -0,0 +1,290 @@
+import {
+	applyChangeEventsToResultWindowBuffer,
+	createResultWindowBuffer,
+	getRecommendedResultWindowBufferSize,
+	getResultWindowBufferResults,
+	resetResultWindowBuffer,
+} from "event-reduce-js";
+
+const NUMERIC_FIELDTYPES = ["Int", "Float", "Currency", "Percent", "Duration", "Check", "Rating"];
+const DATE_FIELDTYPES = ["Date", "Datetime", "Time"];
+// These have no docfield, but the list filters on them.
+const STANDARD_FIELDTYPES = {
+	name: "Data",
+	owner: "Data",
+	modified_by: "Data",
+	creation: "Datetime",
+	modified: "Datetime",
+	docstatus: "Int",
+	idx: "Int",
+	_assign: "Text",
+	_user_tags: "Text",
+	_liked_by: "Text",
+	_comments: "Text",
+};
+const COMPARISON_OPERATORS = { "<": "$lt", ">": "$gt", "<=": "$lte", ">=": "$gte" };
+
+// MariaDB compares names without case and accents (utf8mb4_unicode_ci)
+const name_collator = new Intl.Collator("en", { sensitivity: "base" });
+
+function is_empty(value) {
+	return value === null || value === undefined || value === "";
+}
+
+function like_to_regex(pattern) {
+	const escaped = String(pattern).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+	return "^" + escaped.replace(/%/g, "[\\s\\S]*").replace(/_/g, "[\\s\\S]") + "$";
+}
+
+/**
+ * Translates list view filters like [doctype, fieldname, operator, value]
+ * into a Mongo-style selector: { $and: [{ status: { $in: ["Unpaid", "Overdue"] } }] }.
+ * Returns null if a filter cannot be translated (child table filters, unknown
+ * fields and operators like "Timespan" or "descendants of").
+ */
+export function get_mongo_selector(filters, doctype, get_fieldtype) {
+	const conditions = [];
+	for (const filter of filters || []) {
+		if (!Array.isArray(filter) || filter.length < 4 || filter[0] !== doctype) {
+			return null;
+		}
+		const fieldname = filter[1];
+		const fieldtype = STANDARD_FIELDTYPES[fieldname] || get_fieldtype(fieldname);
+		if (!fieldtype) {
+			return null;
+		}
+		const condition = get_condition(String(filter[2]).toLowerCase(), filter[3], fieldtype);
+		if (!condition) {
+			return null;
+		}
+		conditions.push({ [fieldname]: condition });
+	}
+	return { $and: conditions };
+}
+
+function get_condition(operator, value, fieldtype) {
+	const is_numeric = NUMERIC_FIELDTYPES.includes(fieldtype);
+	const cast = (v) => (is_numeric ? Number(v) : String(v));
+	const is_valid = (v) =>
+		!is_empty(v) && typeof v !== "object" && !(is_numeric && isNaN(cast(v)));
+
+	if (operator === "is") {
+		if (value === "set") return { $nin: [null, ""] };
+		if (value === "not set") return { $in: [null, ""] };
+		return null;
+	}
+	if (operator === "=" || operator === "!=") {
+		if (is_empty(value) && !is_numeric) {
+			return operator === "=" ? { $in: [null, ""] } : { $nin: [null, ""] };
+		}
+		if (!is_valid(value)) return null;
+		return { [operator === "=" ? "$eq" : "$ne"]: cast(value) };
+	}
+	if (operator in COMPARISON_OPERATORS) {
+		if (!is_valid(value)) return null;
+		return { [COMPARISON_OPERATORS[operator]]: cast(value) };
+	}
+	if (operator === "in" || operator === "not in") {
+		const values = typeof value === "string" ? value.split(",").map((v) => v.trim()) : value;
+		if (!Array.isArray(values) || !values.length || !values.every(is_valid)) return null;
+		return { [operator === "in" ? "$in" : "$nin"]: values.map(cast) };
+	}
+	if (operator === "like") {
+		if (is_numeric || !is_valid(value)) return null;
+		return { $regex: like_to_regex(value), $options: "i" };
+	}
+	if (operator === "between") {
+		if (!Array.isArray(value) || value.length !== 2 || !value.every(is_valid)) return null;
+		let [from, to] = value.map(cast);
+		if (fieldtype === "Datetime") {
+			// a date without time means the whole day
+			if (from.length === 10) from += " 00:00:00.000000";
+			if (to.length === 10) to += " 23:59:59.999999";
+		}
+		return { $gte: from, $lte: to };
+	}
+	return null;
+}
+
+export function matches_selector(doc, selector) {
+	return selector.$and.every((condition) =>
+		Object.keys(condition).every((fieldname) =>
+			matches_condition(doc[fieldname], condition[fieldname])
+		)
+	);
+}
+
+function matches_condition(value, condition) {
+	if (value === undefined) value = null;
+	return Object.keys(condition).every((operator) => {
+		const expected = condition[operator];
+		if (typeof expected === "number" && typeof value === "string" && value !== "") {
+			value = Number(value);
+		}
+		switch (operator) {
+			case "$eq":
+				return value === expected;
+			case "$ne":
+				return value !== expected;
+			case "$in":
+				return expected.includes(value);
+			case "$nin":
+				return !expected.includes(value);
+			case "$lt":
+				return value !== null && value < expected;
+			case "$gt":
+				return value !== null && value > expected;
+			case "$lte":
+				return value !== null && value <= expected;
+			case "$gte":
+				return value !== null && value >= expected;
+			case "$regex":
+				return (
+					typeof value === "string" &&
+					new RegExp(expected, condition.$options).test(value)
+				);
+			case "$options":
+				return true;
+		}
+		return false;
+	});
+}
+
+/**
+ * Sorts like `order by sort_by sort_order, name sort_order` of the list query.
+ * Returns null for sort fields whose order depends on the database collation.
+ */
+export function get_sort_comparator(sort_by, sort_order, fieldtype) {
+	fieldtype = STANDARD_FIELDTYPES[sort_by] || fieldtype;
+	let compare_values;
+	if (sort_by === "name") {
+		compare_values = () => 0;
+	} else if (NUMERIC_FIELDTYPES.includes(fieldtype)) {
+		// null is the lowest value
+		const to_number = (v) => (is_empty(v) ? -Infinity : Number(v));
+		compare_values = (a, b) => to_number(a) - to_number(b);
+	} else if (DATE_FIELDTYPES.includes(fieldtype)) {
+		const to_string = (v) => (is_empty(v) ? "" : String(v));
+		compare_values = (a, b) =>
+			to_string(a) < to_string(b) ? -1 : to_string(a) > to_string(b) ? 1 : 0;
+	} else {
+		return null;
+	}
+	const direction = sort_order === "desc" ? -1 : 1;
+	return (a, b) => {
+		const result =
+			compare_values(a[sort_by], b[sort_by]) ||
+			name_collator.compare(String(a.name), String(b.name));
+		// only two versions of the same document are equal
+		return result ? (result * direction > 0 ? 1 : -1) : 1;
+	};
+}
+
+/**
+ * The rows of a list view and some rows after them, kept up to date with
+ * EventReduce and its result window buffer.
+ */
+export class ListResultWindow {
+	/**
+	 * Returns null if EventReduce cannot calculate the result of this list,
+	 * so the list keeps its default realtime updates.
+	 */
+	static create({ doctype, filters, sort_by, sort_order, limit, buffer_size, get_fieldtype }) {
+		const selector = get_mongo_selector(filters, doctype, get_fieldtype);
+		const comparator = get_sort_comparator(sort_by, sort_order, get_fieldtype(sort_by));
+		if (!selector || !comparator || !limit) {
+			return null;
+		}
+		return new ListResultWindow({ selector, comparator, sort_by, limit, buffer_size });
+	}
+
+	constructor({ selector, comparator, sort_by, limit, buffer_size }) {
+		this.selector = selector;
+		this.fieldnames = [...new Set(["name", sort_by, ...selector.$and.flatMap(Object.keys)])];
+		this.limit = limit;
+		this.outdated = true;
+		this.buffer = createResultWindowBuffer(
+			{
+				primaryKey: "name",
+				getDocumentId: (doc) => String(doc.name),
+				sortFields: [sort_by, "name"],
+				// A list view has no skip: "Load More" adds rows to the same list.
+				limit,
+				queryMatcher: (doc) => matches_selector(doc, selector),
+				sortComparator: comparator,
+			},
+			{ limitBufferSize: buffer_size ?? getRecommendedResultWindowBufferSize(limit) }
+		);
+	}
+
+	// number of rows to query, starting at the first row
+	get page_length() {
+		return this.limit + this.buffer.limitBufferSize;
+	}
+
+	get results() {
+		return getResultWindowBufferResults(this.buffer);
+	}
+
+	/**
+	 * Loads the rows of a list query that ran with this.page_length.
+	 * Returns false if the rows are not what the selector and the comparator
+	 * expect, for example because a field is not part of the list query.
+	 */
+	reset(rows) {
+		const { queryMatcher, sortComparator } = this.buffer.queryParams;
+		const usable = rows.every(
+			(row, index) =>
+				this.fieldnames.every((fieldname) => row[fieldname] !== undefined) &&
+				queryMatcher(row) &&
+				(index === 0 || sortComparator(rows[index - 1], row) < 0)
+		);
+		if (usable) {
+			resetResultWindowBuffer(this.buffer, rows);
+		}
+		this.outdated = !usable;
+		return usable;
+	}
+
+	// call this when a change did not reach apply()
+	invalidate() {
+		this.outdated = true;
+	}
+
+	/**
+	 * Applies the changed documents.
+	 * @param names names of the documents that changed
+	 * @param rows their current rows from the list query, without the documents
+	 *     that were deleted, do not match the filters anymore or cannot be read
+	 * @returns { run_full_query: true } or { run_full_query: false, changed, results }
+	 */
+	apply(names, rows) {
+		if (this.outdated) {
+			return { run_full_query: true };
+		}
+		const docs = new Map(rows.map((row) => [String(row.name), row]));
+		const change_events = [];
+		for (const id of new Set(names.map(String))) {
+			const doc = docs.get(id) || null;
+			// The server only tells the name of a changed document. Its previous
+			// state is the row in the buffer. If it is not there, it did not match
+			// or it sorted after the buffer. Both behave like an insert, because
+			// there are no rows before the buffer.
+			const previous = this.buffer.keyDocumentMap.get(id) || null;
+			if (doc && !this.buffer.queryParams.queryMatcher(doc)) {
+				// the selector differs from the filters of the server
+				this.outdated = true;
+				return { run_full_query: true };
+			}
+			if (doc || previous) {
+				const operation = !previous ? "INSERT" : doc ? "UPDATE" : "DELETE";
+				change_events.push({ operation, id, doc, previous });
+			}
+		}
+		const result = applyChangeEventsToResultWindowBuffer(this.buffer, change_events);
+		this.outdated = result.runFullQueryAgain;
+		return result.runFullQueryAgain
+			? { run_full_query: true }
+			: { run_full_query: false, changed: result.changed, results: result.results };
+	}
+}
